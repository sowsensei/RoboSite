#!/bin/bash
# ─── Хук деплоя RoboSite — устанавливается на СЕРВЕРЕ в bare-репозиторий ───
# Путь на сервере: /var/repo/robo-site.git/hooks/post-receive
# (этот файл в репозитории — эталонная копия для переезда/восстановления,
#  git его отсюда НЕ запускает; см. DEPLOY.md).
#
# Срабатывает автоматически при `git push production main`. RoboSite —
# статический сайт, весь контент (включая .exe и PDF) лежит прямо в git,
# поэтому, в отличие от школьного хука, тут НЕ нужно ни доставать
# подпапку site/, ни исключать «живые» папки — раскладываем всё дерево.
set -e

REPO_DIR="/var/repo/robo-site.git"
DEPLOY_DIR="/var/www/robo"
TMP_DIR="$(mktemp -d)"

# Весь коммит целиком (корень репо = веб-корень, подпапки site/ нет).
git --git-dir="$REPO_DIR" archive main | tar -x -C "$TMP_DIR"

# Шапка и футер (partials/) вклеиваются в страницы ЗДЕСЬ, до выкладки, чтобы
# они были в исходном HTML, а не подгружались потом через JS: поисковику нужна
# индексируемая ссылка «Дата-центр itsoft» в футере (условие хостинга) и ссылки
# меню в шапке. js/main.js остаётся страховкой на случай, если сборка не
# отработает, — тогда сайт просто выкладывается как раньше.
# ВАЖНО: папка partials/ должна уехать на сервер (её грузит эта страховка),
# поэтому в rsync ниже она НЕ исключается.
if ! bash "$TMP_DIR/deploy/build-partials.sh" "$TMP_DIR"; then
  echo "⚠️  Сборка шапки/футера не отработала — выкладываю страницы как есть," >&2
  echo "    в браузере их подставит js/main.js (но поисковик их не увидит)." >&2
fi

rsync -a --delete \
  --exclude '/.git*' \
  "$TMP_DIR/" "$DEPLOY_DIR/"
#
# ┌─ НА БУДУЩЕЕ (когда появится PHP-портал с логином учеников) ────────────┐
# │ Данные учеников (прогресс, аккаунты) будут редактироваться прямо на    │
# │ сервере и НЕ должны затираться версией с компьютера. Тогда добавить    │
# │ сюда исключения — по образцу школьного deploy/post-receive, напр.:     │
# │   --exclude '/data/'      # JSON/SQLite с прогрессом                    │
# │   --exclude '/uploads/'   # то, что грузят через портал                 │
# │ и переносить эти папки вручную (rsync), как «живой контент», не код.   │
# └───────────────────────────────────────────────────────────────────────┘

rm -rf "$TMP_DIR"
chown -R www-data:www-data "$DEPLOY_DIR"

echo "✅ RoboSite задеплоен: $(date '+%Y-%m-%d %H:%M:%S')"